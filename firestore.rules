rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'isaacoshiomole0@gmail.com';
    }

    match /adminProviderSecrets/{id} {
      allow read, write: if false;
    }

    match /adminProviderRoutes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webSearchPricing/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /plans/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /paymentTransactions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /entitlements/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /userConsents/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /creditLedger/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
