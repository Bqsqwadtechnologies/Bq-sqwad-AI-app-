rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'isaacoshiomole0@gmail.com'
        && (request.auth.token.admin == true
          || request.auth.token.superAdmin == true
          || request.auth.token.role == 'admin'
          || request.auth.token.role == 'super_admin');
    }

    match /auth-background/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Generated images are stored under the authenticated owner's UID. Reads and
    // deletes require that owner; uploads accept only PNGs within the bounded size.
    match /users/{uid}/generated-images/{imageName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'image/png';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
