rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'isaacoshiomole0@gmail.com'
        && request.auth.token.email_verified == true
        && (request.auth.token.admin == true
          || request.auth.token.superAdmin == true
          || request.auth.token.role == 'admin'
          || request.auth.token.role == 'super_admin');
    }

    match /auth-background/{allPaths=**} {
      // Public auth screens can stream the published sign-in/sign-up media.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chat-background/{allPaths=**} {
      // The shared Main Chat background is public to app clients; only admins may replace it.
      allow read: if true;
      allow write: if isAdmin();
    }

    // Owner-scoped user uploads used by chat attachments, pasted text and File Box.
    match /users/{uid}/uploads/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|audio/.*|video/.*|text/plain|application/pdf|application/json|application/zip|application/msword|application/vnd\\.openxmlformats-officedocument\\..*)');
    }

    // Generated PDFs and other files. The owner alone can access the object.
    match /users/{uid}/generated-files/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 50 * 1024 * 1024;
    }

    // Owner wallpapers and profile images are readable to signed-in users so
    // collaborators can see avatars, but only the owner may write or delete.
    match /avatars/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
